PORT=5000
# Persistent Redis (Upstash / Redis Cloud). Leave empty to use a local JSON file for development.
REDIS_URL=
# Password staff use to sign in to the dashboard. CHANGE THIS.
STAFF_PASSWORD=change-me
# Optional: long random string used to sign login tokens.
AUTH_SECRET=
# Your deployed frontend URL(s), comma separated, no trailing slash.
CORS_ORIGIN=http://localhost:5173
SHOP_TIMEZONE=Africa/Maseru
ORDER_PREFIX=LCH
